#!/usr/bin/env just --justfile

_default:
    just --list

# Build the shared FFI core crate.
ffi-build:
    ./tools/ffi.sh build core

# Run the shared FFI core crate tests.
ffi-test:
    ./tools/ffi.sh test

# Run the shared FFI validation pipeline.
ffi:
    ./tools/ffi.sh test

# Fast compile-time validation for library, binary, and test targets.
check:
    cargo check -p cityjson-index --lib --bins --tests --target-dir target

# Build the production binary.
build *args:
    cargo build -p cityjson-index --bin cjindex --target-dir target {{args}}

clean:
    ./tools/ffi.sh clean

# Run clippy with the project's strict lint settings.
lint:
    cargo clippy -p cityjson-index --lib --bins --tests --target-dir target

# Format this workspace with rustfmt without traversing sibling path dependencies.
fmt:
    cargo fmt -p cityjson-index -p cityjson-index-ffi-core

# Check rustfmt without traversing sibling path dependencies.
fmt-check:
    cargo fmt -p cityjson-index -p cityjson-index-ffi-core -- --check

# Run the library and integration tests.
test:
    cargo test -p cityjson-index --lib --bins --tests --target-dir target

# Test the cgroup profiling supervisor without running an expensive profile.
test-profile-tools:
    python3 -m unittest tools/test_profile_index.py

# Run the benchmark harness with human-readable output.
bench-index *args:
    #!/usr/bin/env bash
    set -euo pipefail
    export CITYJSON_GRONINGEN_CORPUS="${CITYJSON_GRONINGEN_CORPUS:-../../target/benchmarks/groningen-182/cityjson}"
    cargo run --release -p cityjson-index --bin bench-index --target-dir ../../target -- {{args}}

# Run the benchmark harness with JSON output.
bench-index-json *args:
    #!/usr/bin/env bash
    set -euo pipefail
    export CITYJSON_GRONINGEN_CORPUS="${CITYJSON_GRONINGEN_CORPUS:-../../target/benchmarks/groningen-182/cityjson}"
    cargo run --release -p cityjson-index --bin bench-index --target-dir ../../target -- --json {{args}}

# Run one isolated profiling experiment in a transient cgroup v2 scope.
profile-index tool workers tiles description memory_max="":
    #!/usr/bin/env bash
    set -euo pipefail
    cargo build -p cityjson-index --bin bench-index --profile profiling --target-dir ../../target
    python3 tools/profile_index.py \
      --tool "{{tool}}" \
      --workers "{{workers}}" \
      --tiles "{{tiles}}" \
      --description "{{description}}" \
      --memory-max "{{memory_max}}" \
      --corpus "${CITYJSON_GRONINGEN_CORPUS:-../../target/benchmarks/groningen-182/cityjson}" \
      --work-root ../../target/benchmarks/cityjson-index-profile \
      --output-root ../../target/profiling/cityjson-index

# Collect the defined comparison matrix. Heaptrack is a required local dependency.
profile-index-campaign description memory_max:
    #!/usr/bin/env bash
    set -euo pipefail
    for tool in native perf-stat; do
      for repetition in 1 2 3; do
        for workers in 1 4 24; do
          just profile-index "$tool" "$workers" 182 "{{description}} ${tool} repetition ${repetition}" "{{memory_max}}"
        done
      done
    done
    for tool in perf-record heaptrack; do
      for workers in 1 4 24; do
        just profile-index "$tool" "$workers" 24 "{{description}} ${tool}"
      done
    done
    just profile-index cachegrind 1 1 "{{description}} cachegrind"

# Build the shared library and run the Python install smoke tests through tox and tox-uv.
test-python:
    ./tools/ffi.sh test python

# Build API docs for all features without pulling in dependencies.
doc:
    cargo doc --all-features --no-deps --target-dir target

# Build the Python bindings wheel.
build-python:
    ./tools/ffi.sh build python

# Run the release-quality validation pipeline.
ci:
    just fmt-check
    just check
    just lint
    just test
    just test-profile-tools
    just ffi
    just test-python
    just doc
